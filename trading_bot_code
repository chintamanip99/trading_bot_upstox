@app.route('/update', methods=['POST'])
@cross_origin()
def update():
    global lstm_mae, cnn_accuracy, g_current_status, lstm_model, cnn_model
    try:
        data = request.get_json()

        if 'Updated' in data:
            models_loaded = load_all_models()
            g_current_status = f"Models updated: {data['Updated']}"
            return jsonify({'message': 'Models reloaded', 'models_loaded': models_loaded}), 200

        if 'LSTM' in data:
            lstm_mae = float(data['LSTM'])
            return jsonify({'message': 'LSTM MAE updated', 'lstm_mae': lstm_mae}), 200

        if 'CNN' in data:
            cnn_accuracy = float(data['CNN'])
            return jsonify({'message': 'CNN Accuracy updated', 'cnn_accuracy': cnn_accuracy}), 200

        if 'LSTM_MAE' in data and 'CNN_ACC' in data:
            lstm_mae = float(data['LSTM_MAE'])
            cnn_accuracy = float(data['CNN_ACC'])
            return jsonify({'message': 'Metrics updated'}), 200

        return jsonify({'error': 'Missing parameter'}), 400

    except Exception as e:
        return jsonify({'error': str(e)}), 500


