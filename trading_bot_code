def fetch_and_preprocess_data():
    access_token = UPSTOX_ACCESS_TOKEN
    instrument_key = INSTRUMENT_TOKEN_CE
    interval = "1minute"

    to_date = datetime.datetime.now().strftime('%Y-%m-%d')
    from_date = (datetime.datetime.now() - datetime.timedelta(days=10)).strftime('%Y-%m-%d')

    url = f"https://api.upstox.com/v2/historical-candle/{instrument_key}/{interval}/{to_date}/{from_date}"

    headers = {
        'Accept': 'application/json',
        'Authorization': f'Bearer {access_token}'
    }

    try:
        response = requests.get(url, headers=headers)
        if response.status_code == 200:
            data = pd.DataFrame(response.json()['data']['candles'],
                                columns=['Datetime', 'Open', 'High', 'Low', 'Close', 'Volume', 'Extra'])
            data['Datetime'] = pd.to_datetime(data['Datetime'])
            data[['Open', 'High', 'Low', 'Close', 'Volume']] = data[['Open', 'High', 'Low', 'Close', 'Volume']].astype(float)

            if 'Extra' in data.columns:
                data['OI'] = data['Extra'].astype(float)
            else:
                data['OI'] = data['Volume'].rolling(10).mean()
                data['OI'].fillna(data['Volume'], inplace=True)

            data = data[['Open', 'High', 'Low', 'Close', 'Volume', 'OI']]
            data.ffill(inplace=True)
            data.bfill(inplace=True)
            data.fillna(0, inplace=True)

            return data
        else:
            print(f"Failed to fetch data: {response.status_code}")
            return None
    except Exception as e:
        print(f"Error fetching data: {e}")
        return None


def predict_lstm(price_data, current_price):
    global model_predictions, lstm_scaler, target_scaler, latest_lstm_predicted_return, latest_lstm_predicted_price

    try:
        if lstm_model is None or len(price_data) < LSTM_LOOKBACK:
            model_predictions['lstm'] = {'signal': 0, 'confidence': 0.0,
                                          'prediction': current_price, 'predicted_return': 0.0}
            latest_lstm_predicted_return = 0.0
            latest_lstm_predicted_price = current_price
            return

        df = pd.DataFrame({
            'Open': price_data[-LSTM_LOOKBACK:],
            'High': price_data[-LSTM_LOOKBACK:],
            'Low': price_data[-LSTM_LOOKBACK:],
            'Close': price_data[-LSTM_LOOKBACK:],
            'Volume': [1000] * LSTM_LOOKBACK,
            'OI': [5000] * LSTM_LOOKBACK
        })

        feature_data = df[LSTM_FEATURES].values

        try:
            lstm_scaled = lstm_scaler.transform(feature_data)
        except Exception as e:
            print(f"❌ LSTM scaler failed: {e}")
            model_predictions['lstm'] = {'signal': 0, 'confidence': 0.0,
                                          'prediction': current_price, 'predicted_return': 0.0}
            latest_lstm_predicted_return = 0.0
            latest_lstm_predicted_price = current_price
            return

        lstm_X = lstm_scaled.reshape(1, LSTM_LOOKBACK, len(LSTM_FEATURES))
        predicted_scaled = lstm_model.predict(lstm_X, verbose=0)[0][0]

        try:
            predicted_price = target_scaler.inverse_transform([[predicted_scaled]])[0][0]
        except Exception as e:
            print(f"❌ LSTM inverse scaler failed: {e}")
            model_predictions['lstm'] = {'signal': 0, 'confidence': 0.0,
                                          'prediction': current_price, 'predicted_return': 0.0}
            latest_lstm_predicted_return = 0.0
            latest_lstm_predicted_price = current_price
            return

        predicted_return = (predicted_price - current_price) / current_price if current_price > 0 else 0.0

        latest_lstm_predicted_return = predicted_return
        latest_lstm_predicted_price = predicted_price

        price_diff = predicted_price - current_price
        price_diff_pct = abs(predicted_return)

        if price_diff_pct < MIN_PREDICTED_MOVE_PCT:
            signal = 0
            confidence = 0.0
        else:
            # SCALE=100 → 0.20% → 0.20, 0.35% → 0.35, 0.50% → 0.50, 0.80% → 0.80
            confidence = min(LSTM_CONF_CAP, price_diff_pct * LSTM_CONF_SCALE)
            signal = 1 if price_diff > 0 else 2

        model_predictions['lstm'] = {
            'signal': signal,
            'confidence': confidence,
            'prediction': predicted_price,
            'predicted_return': predicted_return
        }

        print(f"📊 LSTM: Sig={signal}, Conf={confidence:.3f}, "
              f"Pred={predicted_price:.2f}, PredRet={predicted_return*100:+.3f}%")

    except Exception as e:
        print(f"❌ LSTM prediction error: {e}")
        traceback.print_exc()
        model_predictions['lstm'] = {'signal': 0, 'confidence': 0.0,
                                      'prediction': current_price, 'predicted_return': 0.0}
        latest_lstm_predicted_return = 0.0
        latest_lstm_predicted_price = current_price


def predict_cnn(price_data, current_price):
    global model_predictions, cnn_scaler

    try:
        if cnn_model is None or len(price_data) < CNN_LOOKBACK:
            model_predictions['cnn'] = {'signal': 0, 'confidence': 0.0, 'class_prob': 0.5}
            return

        df = pd.DataFrame({
            'Open': price_data[-CNN_LOOKBACK:],
            'High': price_data[-CNN_LOOKBACK:],
            'Low': price_data[-CNN_LOOKBACK:],
            'Close': price_data[-CNN_LOOKBACK:],
            'Volume': [1000] * CNN_LOOKBACK,
            'OI': [5000] * CNN_LOOKBACK
        })

        feature_data = df[CNN_FEATURES].values

        try:
            cnn_values = cnn_scaler.transform(feature_data)
        except Exception as e:
            print(f"❌ CNN scaler failed: {e}")
            model_predictions['cnn'] = {'signal': 0, 'confidence': 0.0, 'class_prob': 0.5}
            return

        gaf = GramianAngularField(method="summation", image_size=CNN_LOOKBACK)
        gaf_images = gaf.fit_transform(cnn_values.T)
        cnn_X = gaf_images.transpose(1, 2, 0)[np.newaxis, ...]

        expected = cnn_model.input_shape
        if expected[1] is not None and cnn_X.shape[1] != expected[1]:
            print(f"❌ CNN shape mismatch: got {cnn_X.shape}, expected {expected}")
            model_predictions['cnn'] = {'signal': 0, 'confidence': 0.0, 'class_prob': 0.5}
            return

        cnn_pred = cnn_model.predict(cnn_X, verbose=0)
        predicted_class = int(np.argmax(cnn_pred, axis=1)[0])
        class_probabilities = softmax(cnn_pred).numpy()[0]
        class_prob = float(class_probabilities[predicted_class])

        # ---- CNN margin filter (relaxed) ----
        sorted_probs = np.sort(class_probabilities)[::-1]
        lead = float(sorted_probs[0] - sorted_probs[1])

        print(f"📊 CNN probs: Hold={class_probabilities[0]:.3f}, "
              f"Buy={class_probabilities[1]:.3f}, Sell={class_probabilities[2]:.3f} | "
              f"lead={lead:.3f}")

        # ---- Loosened CNN threshold + relaxed margin ----
        if predicted_class == 1 and class_prob > CNN_THRESHOLD and lead >= CNN_MIN_LEAD:
            signal = 1
        elif predicted_class == 2 and class_prob > CNN_THRESHOLD and lead >= CNN_MIN_LEAD:
            signal = 2
        else:
            signal = 0

        model_predictions['cnn'] = {
            'signal': signal,
            'confidence': class_prob,
            'class_prob': class_prob,
            'predicted_class': predicted_class,
            'lead': lead
        }

        print(f"📊 CNN: Class={predicted_class}, Sig={signal}, Conf={class_prob:.3f}, Lead={lead:.3f}")

    except Exception as e:
        print(f"❌ CNN prediction error: {e}")
        traceback.print_exc()
        model_predictions['cnn'] = {'signal': 0, 'confidence': 0.0, 'class_prob': 0.5}


def ensemble_signal_generation(current_price):
    """
    Loosened strict ensemble (still requires 2-model consensus):
      - Both models must be non-zero and agree on direction.
      - Both must individually exceed their (loosened) confidence floors.
      - CNN must have a modest lead over runner-up class.
      - LSTM predicted-return direction must match signal direction.
      - Ensemble confidence = MIN(lstm_conf, cnn_conf).
    """
    global agreement_history, ticks_since_last_eval

    try:
        lstm_signal = model_predictions['lstm']['signal']
        lstm_conf   = model_predictions['lstm']['confidence']
        lstm_ret    = model_predictions['lstm']['predicted_return']
        cnn_signal  = model_predictions['cnn']['signal']
        cnn_conf    = model_predictions['cnn']['confidence']
        cnn_lead    = model_predictions['cnn'].get('lead', 0.0)

        print(f"📊 Raw - LSTM: {lstm_signal} ({lstm_conf:.3f}, ret={lstm_ret*100:+.3f}%), "
              f"CNN: {cnn_signal} ({cnn_conf:.3f}, lead={cnn_lead:.3f})")

        agreement_history.append((lstm_signal, cnn_signal))
        if len(agreement_history) > 10:
            agreement_history.pop(0)

        def _reject(reason):
            if DEBUG_GATES:
                print(f"❌ REJECT: {reason}")
            return 0, 0.0, {
                'lstm': lstm_signal, 'cnn': cnn_signal,
                'consensus': 'REJECT',
                'lstm_conf': lstm_conf, 'cnn_conf': cnn_conf,
                'ensemble_confidence': 0.0,
                'reject_reason': reason
            }

        # Gate 1: both actionable
        if REQUIRE_BOTH_ACTIONABLE and (lstm_signal == 0 or cnn_signal == 0):
            return _reject(
                f"both must be actionable (LSTM={lstm_signal}, CNN={cnn_signal})"
            )

        # Gate 2: agree on direction
        if lstm_signal != cnn_signal:
            return _reject(
                f"models disagree (LSTM={lstm_signal}, CNN={cnn_signal})"
            )

        # Gate 3: LSTM directional sanity check
        if LSTM_DIRECTIONAL_AGREE:
            if lstm_signal == 1 and lstm_ret <= 0:
                return _reject(f"LSTM signal=1 but pred_ret={lstm_ret*100:+.3f}% (not bullish)")
            if lstm_signal == 2 and lstm_ret >= 0:
                return _reject(f"LSTM signal=2 but pred_ret={lstm_ret*100:+.3f}% (not bearish)")

        # Gate 4: LSTM floor (loosened)
        if lstm_conf < MIN_LSTM_CONFIDENCE:
            return _reject(
                f"LSTM conf {lstm_conf:.3f} < {MIN_LSTM_CONFIDENCE}"
            )

        # Gate 5: CNN floor (loosened)
        if cnn_conf < MIN_CNN_CONFIDENCE:
            return _reject(
                f"CNN conf {cnn_conf:.3f} < {MIN_CNN_CONFIDENCE}"
            )

        # Gate 6: CNN margin (relaxed)
        if cnn_lead < CNN_MIN_LEAD:
            return _reject(
                f"CNN lead {cnn_lead:.3f} < {CNN_MIN_LEAD}"
            )

        # Gate 7: consecutive-tick agreement (skipped if MIN_MODEL_AGREEMENT_TICKS == 1)
        if MIN_MODEL_AGREEMENT_TICKS > 1:
            needed = MIN_MODEL_AGREEMENT_TICKS
            tail = agreement_history[-needed:]
            if len(tail) < needed or not all(
                ls == lstm_signal and cs == cnn_signal for ls, cs in tail
            ):
                return _reject(
                    f"not enough consecutive agreement "
                    f"({len(tail)}/{needed} ticks with same signal)"
                )

        # Consensus achieved
        final_signal = lstm_signal
        consensus_type = "BOTH_AGREE_STRICT"
        ensemble_confidence = min(lstm_conf, cnn_conf)

        print(f"✅ STRICT CONSENSUS: Sig={final_signal}, "
              f"EnsConf(min)={ensemble_confidence:.3f} "
              f"[L={lstm_conf:.3f}, C={cnn_conf:.3f}]")

        # Gate 8: ensemble threshold
        if ensemble_confidence < CONFIDENCE_THRESHOLD:
            print(f"❌ REJECT: ensemble conf {ensemble_confidence:.3f} "
                  f"< {CONFIDENCE_THRESHOLD}")
            final_signal = 0

        model_signals = {
            'lstm': lstm_signal,
            'cnn': cnn_signal,
            'consensus': consensus_type,
            'lstm_conf': lstm_conf,
            'cnn_conf': cnn_conf,
            'ensemble_confidence': ensemble_confidence,
            'reject_reason': None if final_signal else 'ensemble_conf_below_threshold'
        }

        print(f"🎯 FINAL: {final_signal} | {consensus_type}")
        return final_signal, ensemble_confidence, model_signals

    except Exception as e:
        print(f"❌ Ensemble error: {e}")
        return 0, 0.0, {
            'lstm': 0, 'cnn': 0, 'consensus': 'ERROR',
            'lstm_conf': 0, 'cnn_conf': 0,
            'ensemble_confidence': 0, 'reject_reason': str(e)
        }


def update_status_ensemble(ce_price, pe_price, final_signal, ensemble_confidence, model_signals):
    global current_status, g_current_status, last_prediction_time, paper_trading_bot
    global latest_lstm_predicted_return

    last_prediction_time = datetime.datetime.now()
    stats = paper_trading_bot.get_performance_stats()

    lstm_signal = model_signals.get('lstm', 0)
    cnn_signal = model_signals.get('cnn', 0)
    consensus_status = model_signals.get('consensus', 'UNKNOWN')
    lstm_conf = model_signals.get('lstm_conf', 0)
    cnn_conf = model_signals.get('cnn_conf', 0)

    if consensus_status == 'BOTH_AGREE_STRICT':
        consensus_indicator = "✅STRICT"
    elif consensus_status == 'BOTH_AGREE':
        consensus_indicator = "✅BOTH"
    else:
        consensus_indicator = "❌NONE"

    signal_text = "HOLD"
    if final_signal == 1:
        signal_text = "BUY_CE"
    elif final_signal == 2:
        signal_text = "BUY_PE"

    if paper_trading_bot.position is not None:
        dyn_info = (f"Tgt:{paper_trading_bot.active_target_pct*100:.2f}% "
                    f"SL:{paper_trading_bot.active_sl_pct*100:.2f}%")
    else:
        dyn_info = f"PredRet:{latest_lstm_predicted_return*100:+.2f}%"

    current_status = (
        f"CE:{ce_price:.2f} PE:{pe_price:.2f} | "
        f"Bal:{paper_trading_bot.balance:,.0f} ({stats['return_percentage']:+.1f}%) | "
        f"Pos:{paper_trading_bot.position or 'None'} | "
        f"T:{stats['total_trades']}(today {stats['trades_today']}/{MAX_TRADES_PER_DAY}) | "
        f"WR:{stats['win_rate']:.0f}% | "
        f"Sig:{signal_text}({ensemble_confidence:.2f}) {consensus_indicator} | "
        f"L:{lstm_signal}({lstm_conf:.2f}) C:{cnn_signal}({cnn_conf:.2f}) | "
        f"{dyn_info} | "
        f"{datetime.datetime.now().strftime('%H:%M:%S')}"
    )

    g_current_status = current_status
    return current_status


def predict_with_ensemble(price_data, ce_price, pe_price):
    try:
        global current_status, predicted_next_close, last_price, g_current_status, last_signal

        if len(price_data) < lookback:
            g_current_status = f"Data {len(price_data)}/{lookback}"
            return

        current_price = price_data[-1]
        last_price = current_price

        predict_lstm(price_data, current_price)
        predict_cnn(price_data, current_price)

        print(f"\n🔎 CONFIDENCE DEBUG: "
              f"LSTM sig={model_predictions['lstm']['signal']} "
              f"conf={model_predictions['lstm']['confidence']:.4f} "
              f"pred_ret={model_predictions['lstm']['predicted_return']*100:.3f}% | "
              f"CNN sig={model_predictions['cnn']['signal']} "
              f"conf={model_predictions['cnn']['confidence']:.4f}")

        final_signal, ensemble_confidence, model_signals = ensemble_signal_generation(current_price)

        predicted_next_close = model_predictions['lstm']['prediction']
        last_signal = final_signal

        paper_trading_bot.execute_paper_trade(final_signal, ce_price, pe_price,
                                              ensemble_confidence, model_signals)

        update_status_ensemble(ce_price, pe_price, final_signal, ensemble_confidence, model_signals)

    except Exception as e:
        g_current_status = f"predict error: {e}"
        traceback.print_exc()


def start_websocket():
    global live_data, g_current_status, ce_price, pe_price, ce_data, pe_data
    tick_count = 0
    ce_tick_count = 0
    pe_tick_count = 0

    def on_error(error):
        print(f"WebSocket error: {error}")
        g_current_status = f"WebSocket error: {error}"

    def on_message(message):
        global live_data, last_price, g_current_status, ce_price, pe_price, ce_data, pe_data
        nonlocal tick_count, ce_tick_count, pe_tick_count

        try:
            if isinstance(message, str):
                data = json.loads(message)
            elif isinstance(message, dict):
                data = message
            else:
                return

            if tick_count < 3:
                print(f"📨 Raw message {tick_count}: {json.dumps(data, indent=2)[:500]}...")

            if 'type' in data:
                if data['type'] == 'sub':
                    print(f"✅ Subscription confirmed")
                    return
                elif data['type'] == 'market_info':
                    return
                elif data['type'] == 'error':
                    print(f"❌ WebSocket error: {data.get('message', '')}")
                    return

            if 'feeds' in data:
                feeds = data['feeds']

                ce_ltp = None
                if INSTRUMENT_TOKEN_CE in feeds:
                    ce_feed = feeds[INSTRUMENT_TOKEN_CE]
                    if 'ltp' in ce_feed:
                        ce_ltp = float(ce_feed['ltp'])
                    elif 'fullFeed' in ce_feed and 'marketFF' in ce_feed['fullFeed']:
                        market_ff = ce_feed['fullFeed']['marketFF']
                        if 'ltpc' in market_ff and 'ltp' in market_ff['ltpc']:
                            ce_ltp = float(market_ff['ltpc']['ltp'])
                    elif 'fullFeed' in ce_feed and 'ltpc' in ce_feed['fullFeed']:
                        if 'ltp' in ce_feed['fullFeed']['ltpc']:
                            ce_ltp = float(ce_feed['fullFeed']['ltpc']['ltp'])
                    elif 'price' in ce_feed:
                        ce_ltp = float(ce_feed['price'])
                    elif 'last_price' in ce_feed:
                        ce_ltp = float(ce_feed['last_price'])

                if ce_ltp is not None and ce_ltp > 0:
                    ce_price = ce_ltp
                    ce_tick_count += 1
                    if len(ce_data) >= lookback:
                        ce_data.pop(0)
                    ce_data.append(ce_price)

                pe_ltp = None
                if INSTRUMENT_TOKEN_PE in feeds:
                    pe_feed = feeds[INSTRUMENT_TOKEN_PE]
                    if 'ltp' in pe_feed:
                        pe_ltp = float(pe_feed['ltp'])
                    elif 'fullFeed' in pe_feed and 'marketFF' in pe_feed['fullFeed']:
                        market_ff = pe_feed['fullFeed']['marketFF']
                        if 'ltpc' in market_ff and 'ltp' in market_ff['ltpc']:
                            pe_ltp = float(market_ff['ltpc']['ltp'])
                    elif 'fullFeed' in pe_feed and 'ltpc' in pe_feed['fullFeed']:
                        if 'ltp' in pe_feed['fullFeed']['ltpc']:
                            pe_ltp = float(pe_feed['fullFeed']['ltpc']['ltp'])
                    elif 'price' in pe_feed:
                        pe_ltp = float(pe_feed['price'])
                    elif 'last_price' in pe_feed:
                        pe_ltp = float(pe_feed['last_price'])

                if pe_ltp is not None and pe_ltp > 0:
                    pe_price = pe_ltp
                    pe_tick_count += 1
                    if len(pe_data) >= lookback:
                        pe_data.pop(0)
                    pe_data.append(pe_price)

            tick_count += 1

            if ce_price > 0:
                last_price = ce_price
                if len(live_data) >= lookback:
                    live_data.pop(0)
                live_data.append(ce_price)
            elif pe_price > 0:
                last_price = pe_price
                if len(live_data) >= lookback:
                    live_data.pop(0)
                live_data.append(pe_price)

            try:
                if ce_price > 0 and pe_price > 0:
                    paper_trading_bot.check_exit(ce_price, pe_price)
            except Exception as e:
                print(f"⚠️ check_exit error: {e}")

            stats = paper_trading_bot.get_performance_stats()
            g_current_status = (
                f"CE:{ce_price:.2f} PE:{pe_price:.2f} | "
                f"Bal:{paper_trading_bot.balance:,.0f} ({stats['return_percentage']:+.1f}%) | "
                f"Pos:{paper_trading_bot.position or 'None'} | "
                f"T:{stats['total_trades']}(today {stats['trades_today']}/{MAX_TRADES_PER_DAY}) | "
                f"WR:{stats['win_rate']:.0f}% | "
                f"{datetime.datetime.now().strftime('%H:%M:%S')}"
            )

            if len(live_data) >= lookback and ce_price > 0 and pe_price > 0:
                predict_with_ensemble(live_data, ce_price, pe_price)

            if tick_count % 30 == 0:
                sys.stdout.write(f"\r{g_current_status}")
                sys.stdout.flush()

        except json.JSONDecodeError as e:
            print(f"❌ JSON decode error: {e}")
        except Exception as e:
            print(f"\n❌ Message error: {e}")
            traceback.print_exc()

    try:
        configuration = get_upstox_config()
        print("🔌 Creating Upstox WebSocket connection...")

        streamer = upstox_client.MarketDataStreamerV3(
            upstox_client.ApiClient(configuration),
            [INSTRUMENT_TOKEN_CE, INSTRUMENT_TOKEN_PE],
            "full"
        )

        streamer.on("message", on_message)
        streamer.on("error", on_error)

        print(f"📡 Connecting...")
        g_current_status = "Connecting to Upstox WebSocket..."
        streamer.connect()
        print("✅ WebSocket connected!")

    except Exception as e:
        print(f"❌ WebSocket failed: {e}")
        traceback.print_exc()


