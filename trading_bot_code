def fetch_and_preprocess_data():
    access_token = UPSTOX_ACCESS_TOKEN
    instrument_key = INSTRUMENT_TOKEN_CE
    interval = "1minute"
    
    to_date = datetime.datetime.now().strftime('%Y-%m-%d')
    from_date = (datetime.datetime.now() - datetime.timedelta(days=10)).strftime('%Y-%m-%d')
    
    url = f"https://api.upstox.com/v2/historical-candle/{instrument_key}/{interval}/{to_date}/{from_date}"
   
    headers = {
        'Accept': 'application/json',
        'Authorization': f'Bearer {access_token}'
    }
    
    try:
        response = requests.get(url, headers=headers)
        if response.status_code == 200:
            data = pd.DataFrame(response.json()['data']['candles'], 
                              columns=['Datetime', 'Open', 'High', 'Low', 'Close', 'Volume', 'Extra'])
            
            data['Datetime'] = pd.to_datetime(data['Datetime'])
            data[['Open', 'High', 'Low', 'Close', 'Volume']] = data[['Open', 'High', 'Low', 'Close', 'Volume']].astype(float)
            
            # Add OI (Open Interest) - Use Extra column as OI if available
            if 'Extra' in data.columns:
                data['OI'] = data['Extra'].astype(float)
            else:
                # If no OI data, create a placeholder
                data['OI'] = data['Volume'].rolling(10).mean()
                data['OI'].fillna(data['Volume'], inplace=True)
            
            # Only keep OHLCV + OI (no indicators)
            data = data[['Open', 'High', 'Low', 'Close', 'Volume', 'OI']]
            
            # Handle missing values
            data.ffill(inplace=True)
            data.bfill(inplace=True)
            data.fillna(0, inplace=True)
            
            return data
        else:
            print(f"Failed to fetch data: {response.status_code} - {response.text}")
            return None
    except Exception as e:
        print(f"Error fetching data: {e}")
        return None

def predict_lstm(price_data, current_price):
    global model_predictions, lstm_scaler, target_scaler
    
    try:
        if lstm_model is None or len(price_data) < lookback:
            model_predictions['lstm'] = {'signal': 0, 'confidence': 0.0, 'prediction': current_price}
            return

        # Create dataframe with OHLCV + OI data
        df = pd.DataFrame({
            'Open': price_data[-lookback:],
            'High': price_data[-lookback:],
            'Low': price_data[-lookback:],
            'Close': price_data[-lookback:],
            'Volume': [1000] * lookback,
            'OI': [5000] * lookback
        })
        
        # Extract features (OHLCV + OI only)
        feature_data = df[LSTM_FEATURES].values
        
        # Scale features - use saved scaler if available
        try:
            lstm_scaled = lstm_scaler.transform(feature_data)
        except:
            lstm_scaler.fit(feature_data)
            lstm_scaled = lstm_scaler.transform(feature_data)
        
        lstm_X = lstm_scaled.reshape(1, lookback, len(LSTM_FEATURES))
        
        # Make prediction
        predicted_scaled = lstm_model.predict(lstm_X, verbose=0)[0][0]
        
        # Inverse transform the prediction
        try:
            close_prices = df['Close'].values.reshape(-1, 1)
            target_scaler.fit(close_prices)
            predicted_price = target_scaler.inverse_transform([[predicted_scaled]])[0][0]
        except:
            predicted_price = predicted_scaled * 100 + current_price
            
        # Calculate signal based on prediction vs current price
        price_diff = predicted_price - current_price
        confidence = min(0.95, max(0.2, abs(price_diff / current_price) * 8))
        
        # NO THRESHOLD - Signal based solely on direction
        if price_diff > 0:
            signal = 1  # BUY CE (Bullish)
        elif price_diff < 0:
            signal = 2  # BUY PE (Bearish)
        else:
            signal = 0  # HOLD
            
        model_predictions['lstm'] = {
            'signal': signal,
            'confidence': confidence,
            'prediction': predicted_price
        }
        
        print(f"📊 LSTM: Signal={signal}, Conf={confidence:.3f}, Pred={predicted_price:.2f}, Diff={price_diff:.2f}")
        
    except Exception as e:
        print(f"❌ LSTM prediction error: {e}")
        traceback.print_exc()
        model_predictions['lstm'] = {'signal': 0, 'confidence': 0.0, 'prediction': current_price}

def predict_cnn(price_data, current_price):
    global model_predictions, cnn_scaler
    
    try:
        if cnn_model is None or len(price_data) < lookback:
            model_predictions['cnn'] = {'signal': 0, 'confidence': 0.0, 'class_prob': 0.5}
            return

        # Create dataframe with OHLCV + OI data
        df = pd.DataFrame({
            'Open': price_data[-lookback:],
            'High': price_data[-lookback:],
            'Low': price_data[-lookback:],
            'Close': price_data[-lookback:],
            'Volume': [1000] * lookback,
            'OI': [5000] * lookback
        })
        
        # Extract features (OHLCV + OI only)
        feature_data = df[CNN_FEATURES].values
        
        # Scale features for CNN
        try:
            cnn_values = cnn_scaler.transform(feature_data)
        except:
            cnn_scaler.fit(feature_data)
            cnn_values = cnn_scaler.transform(feature_data)
        
        # Create GAF images
        gaf = GramianAngularField(method="summation", image_size=lookback)
        gaf_images = gaf.fit_transform(cnn_values.T)
        cnn_X = gaf_images.transpose(1, 2, 0)[np.newaxis, ...]
        
        # Make prediction
        cnn_pred = cnn_model.predict(cnn_X, verbose=0)
        predicted_class = np.argmax(cnn_pred, axis=1)[0]
        class_probabilities = softmax(cnn_pred).numpy()[0]
        class_prob = class_probabilities[predicted_class]
        
        # Map class to signal
        # Class 0 = Hold, Class 1 = Buy (Bullish), Class 2 = Sell (Bearish)
        if predicted_class == 1 and class_prob > 0.35:
            signal = 1  # BUY CE
        elif predicted_class == 2 and class_prob > 0.35:
            signal = 2  # BUY PE
        else:
            signal = 0  # HOLD
            
        model_predictions['cnn'] = {
            'signal': signal,
            'confidence': class_prob,
            'class_prob': class_prob,
            'predicted_class': predicted_class
        }
        
        print(f"📊 CNN: Class={predicted_class}, Signal={signal}, Conf={class_prob:.3f}")
        
    except Exception as e:
        print(f"❌ CNN prediction error: {e}")
        traceback.print_exc()
        model_predictions['cnn'] = {'signal': 0, 'confidence': 0.0, 'class_prob': 0.5}

def ensemble_signal_generation(current_price):
    try:
        lstm_signal = model_predictions['lstm']['signal']
        lstm_conf = model_predictions['lstm']['confidence']
        
        cnn_signal = model_predictions['cnn']['signal']
        cnn_conf = model_predictions['cnn']['confidence']
        
        print(f"📊 Raw Signals - LSTM: {lstm_signal} (conf: {lstm_conf:.3f}), CNN: {cnn_signal} (conf: {cnn_conf:.3f})")
        
        # RULE: LSTM and CNN must agree on the same signal
        if lstm_signal != 0 and cnn_signal == lstm_signal:
            # Both models agree
            final_signal = lstm_signal
            consensus_type = "BOTH_AGREE"
            ensemble_confidence = (lstm_conf + cnn_conf) / 2
            print(f"✅ BOTH MODELS AGREE: Signal {final_signal}")
        else:
            # No agreement
            final_signal = 0
            consensus_type = "NO_CONSENSUS"
            ensemble_confidence = 0.0
            if lstm_signal == 0:
                print(f"⏸️ LSTM NEUTRAL: No direction")
            elif cnn_signal == 0:
                print(f"⏸️ CNN NEUTRAL: No direction")
            else:
                print(f"⏸️ DISAGREEMENT: LSTM={lstm_signal}, CNN={cnn_signal}")
        
        # Apply confidence threshold
        if final_signal != 0 and ensemble_confidence < 0.25:
            print(f"⚠️ Confidence too low: {ensemble_confidence:.3f} < 0.25")
            final_signal = 0
        
        model_signals = {
            'lstm': lstm_signal,
            'cnn': cnn_signal,
            'consensus': consensus_type,
            'lstm_conf': lstm_conf,
            'cnn_conf': cnn_conf,
            'ensemble_confidence': ensemble_confidence
        }
        
        print(f"🎯 FINAL SIGNAL: {final_signal} (1=BUY CE, 2=BUY PE, 0=HOLD) | {consensus_type}")
        
        return final_signal, ensemble_confidence, model_signals
        
    except Exception as e:
        print(f"❌ Ensemble signal generation error: {e}")
        return 0, 0.30, {'lstm': 0, 'cnn': 0, 'consensus': 'ERROR'}

def update_status_ensemble(ce_price, pe_price, final_signal, ensemble_confidence, model_signals):
    global current_status, g_current_status, last_prediction_time, paper_trading_bot
    
    last_prediction_time = datetime.datetime.now()
    stats = paper_trading_bot.get_performance_stats()
    
    lstm_signal = model_signals.get('lstm', 0)
    cnn_signal = model_signals.get('cnn', 0)
    consensus_status = model_signals.get('consensus', 'UNKNOWN')
    lstm_conf = model_signals.get('lstm_conf', 0)
    cnn_conf = model_signals.get('cnn_conf', 0)
    
    if consensus_status == 'BOTH_AGREE':
        consensus_indicator = "✅BOTH_AGREE"
    else:
        consensus_indicator = "❌NO_AGREEMENT"
    
    signal_text = "HOLD"
    if final_signal == 1:
        signal_text = "BUY_CE"
    elif final_signal == 2:
        signal_text = "BUY_PE"
    
    current_status = (
        f"CE: {ce_price:.2f} | PE: {pe_price:.2f} | "
        f"Balance: {paper_trading_bot.balance:,.2f} ({stats['return_percentage']:+.1f}%) | "
        f"Position: {paper_trading_bot.position or 'None'} | "
        f"Trades: {stats['total_trades']} | "
        f"WinRate: {stats['win_rate']:.1f}% | "
        f"Signal: {signal_text} ({ensemble_confidence:.3f}) | "
        f"{consensus_indicator} | "
        f"LSTM:{lstm_signal}({lstm_conf:.2f}) CNN:{cnn_signal}({cnn_conf:.2f}) | "
        f"SL:4% | Target:1% | "
        f"Time: {datetime.datetime.now().strftime('%H:%M:%S')}"
    )
    
    g_current_status = current_status
    return current_status

def predict_with_ensemble(price_data, ce_price, pe_price):
    try:
        global current_status, predicted_next_close, last_price, g_current_status, last_signal
        
        if len(price_data) < lookback:
            error_msg = f"Error: Not enough data points (have {len(price_data)}, need {lookback})"
            print(error_msg)
            g_current_status = error_msg
            return

        current_price = price_data[-1]
        last_price = current_price

        predict_lstm(price_data, current_price)
        predict_cnn(price_data, current_price)
        
        final_signal, ensemble_confidence, model_signals = ensemble_signal_generation(current_price)
        
        predicted_next_close = model_predictions['lstm']['prediction']
        last_signal = final_signal

        paper_trading_bot.execute_paper_trade(final_signal, ce_price, pe_price, ensemble_confidence, model_signals)

        update_status_ensemble(ce_price, pe_price, final_signal, ensemble_confidence, model_signals)
        
    except Exception as e:
        error_msg = f"Critical error in predict_with_ensemble(): {str(e)}"
        print(f"\n{error_msg}")
        g_current_status = error_msg
        traceback.print_exc()

def start_websocket():
    """Start WebSocket connection for real-time price data from Upstox"""
    global live_data, g_current_status, ce_price, pe_price, ce_data, pe_data
    tick_count = 0
    ce_tick_count = 0
    pe_tick_count = 0

    def on_error(error):
        print(f"WebSocket error: {error}")
        g_current_status = f"WebSocket error: {error}"

    def on_message(message):
        global live_data, last_price, g_current_status, ce_price, pe_price, ce_data, pe_data
        nonlocal tick_count, ce_tick_count, pe_tick_count

        try:
            # Handle different message types
            if isinstance(message, str):
                data = json.loads(message)
            elif isinstance(message, dict):
                data = message
            else:
                return
            
            # Debug: print first few messages
            if tick_count < 3:
                print(f"📨 Raw message {tick_count}: {json.dumps(data, indent=2)[:500]}...")
            
            # Check for subscription confirmation
            if 'type' in data:
                if data['type'] == 'sub':
                    print(f"✅ Subscription confirmed: {data.get('s', 'ok')}")
                    return
                elif data['type'] == 'market_info':
                    return
                elif data['type'] == 'error':
                    print(f"❌ WebSocket error: {data.get('message', 'Unknown error')}")
                    g_current_status = f"WebSocket error: {data.get('message', 'Unknown error')}"
                    return
            
            # Process market data
            if 'feeds' in data:
                feeds = data['feeds']
                
                # Process CE data - try multiple possible structures
                ce_ltp = None
                if INSTRUMENT_TOKEN_CE in feeds:
                    ce_feed = feeds[INSTRUMENT_TOKEN_CE]
                    
                    # Try different structures
                    if 'ltp' in ce_feed:
                        ce_ltp = float(ce_feed['ltp'])
                    elif 'fullFeed' in ce_feed and 'marketFF' in ce_feed['fullFeed']:
                        market_ff = ce_feed['fullFeed']['marketFF']
                        if 'ltpc' in market_ff and 'ltp' in market_ff['ltpc']:
                            ce_ltp = float(market_ff['ltpc']['ltp'])
                    elif 'fullFeed' in ce_feed and 'ltpc' in ce_feed['fullFeed']:
                        if 'ltp' in ce_feed['fullFeed']['ltpc']:
                            ce_ltp = float(ce_feed['fullFeed']['ltpc']['ltp'])
                    elif 'price' in ce_feed:
                        ce_ltp = float(ce_feed['price'])
                    elif 'last_price' in ce_feed:
                        ce_ltp = float(ce_feed['last_price'])
                
                if ce_ltp is not None and ce_ltp > 0:
                    ce_price = ce_ltp
                    ce_tick_count += 1
                    
                    if len(ce_data) >= lookback:
                        ce_data.pop(0)
                    ce_data.append(ce_price)
                    
                    if tick_count < 5:
                        print(f"✅ CE Price: {ce_price:.2f}")
                
                # Process PE data
                pe_ltp = None
                if INSTRUMENT_TOKEN_PE in feeds:
                    pe_feed = feeds[INSTRUMENT_TOKEN_PE]
                    
                    if 'ltp' in pe_feed:
                        pe_ltp = float(pe_feed['ltp'])
                    elif 'fullFeed' in pe_feed and 'marketFF' in pe_feed['fullFeed']:
                        market_ff = pe_feed['fullFeed']['marketFF']
                        if 'ltpc' in market_ff and 'ltp' in market_ff['ltpc']:
                            pe_ltp = float(market_ff['ltpc']['ltp'])
                    elif 'fullFeed' in pe_feed and 'ltpc' in pe_feed['fullFeed']:
                        if 'ltp' in pe_feed['fullFeed']['ltpc']:
                            pe_ltp = float(pe_feed['fullFeed']['ltpc']['ltp'])
                    elif 'price' in pe_feed:
                        pe_ltp = float(pe_feed['price'])
                    elif 'last_price' in pe_feed:
                        pe_ltp = float(pe_feed['last_price'])
                
                if pe_ltp is not None and pe_ltp > 0:
                    pe_price = pe_ltp
                    pe_tick_count += 1
                    
                    if len(pe_data) >= lookback:
                        pe_data.pop(0)
                    pe_data.append(pe_price)
                    
                    if tick_count < 5:
                        print(f"✅ PE Price: {pe_price:.2f}")
            
            tick_count += 1
            
            # Update live data with CE price (primary instrument)
            if ce_price > 0:
                last_price = ce_price
                if len(live_data) >= lookback:
                    live_data.pop(0)
                live_data.append(ce_price)
            elif pe_price > 0:
                last_price = pe_price
                if len(live_data) >= lookback:
                    live_data.pop(0)
                live_data.append(pe_price)
            
            # Update status
            stats = paper_trading_bot.get_performance_stats()
            g_current_status = (
                f"CE: {ce_price:.2f} | PE: {pe_price:.2f} | "
                f"Balance: {paper_trading_bot.balance:,.2f} ({stats['return_percentage']:+.1f}%) | "
                f"Position: {paper_trading_bot.position or 'None'} | "
                f"Trades: {stats['total_trades']} | "
                f"WinRate: {stats['win_rate']:.1f}% | "
                f"SL:4% | Target:1% | "
                f"Time: {datetime.datetime.now().strftime('%H:%M:%S')}"
            )
            
            # Run prediction if we have enough data
            if len(live_data) >= lookback and ce_price > 0 and pe_price > 0:
                predict_with_ensemble(live_data, ce_price, pe_price)
            else:
                g_current_status += f" | Data: {len(live_data)}/{lookback}"
            
            if tick_count % 30 == 0:
                sys.stdout.write(f"\r{g_current_status}")
                sys.stdout.flush()
                
        except json.JSONDecodeError as e:
            print(f"❌ JSON decode error: {e}")
        except Exception as e:
            error_msg = f"Error in message processing: {str(e)}"
            print(f"\n{error_msg}")
            g_current_status = error_msg
            traceback.print_exc()

    try:
        configuration = get_upstox_config()
        
        # Create WebSocket connection
        print("🔌 Creating Upstox WebSocket connection...")
        
        streamer = upstox_client.MarketDataStreamerV3(
            upstox_client.ApiClient(configuration),
            [INSTRUMENT_TOKEN_CE, INSTRUMENT_TOKEN_PE],
            "full"
        )
        
        streamer.on("message", on_message)
        streamer.on("error", on_error)
        
        print(f"📡 Connecting to Upstox WebSocket for MCX instruments...")
        print(f"📊 CE Instrument: {INSTRUMENT_TOKEN_CE}")
        print(f"📊 PE Instrument: {INSTRUMENT_TOKEN_PE}")
        g_current_status = "Connecting to Upstox WebSocket..."
        
        streamer.connect()
        print("✅ WebSocket connected successfully!")
        
    except Exception as e:
        error_msg = f"Failed to establish WebSocket connection: {e}"
        print(f"❌ {error_msg}")
        g_current_status = error_msg
        traceback.print_exc()

