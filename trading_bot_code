    def calculate_max_shares(self, entry_price, position_type='long'):
        if entry_price <= 0:
            return self.lot_size

        available_capital = self.balance * CAPITAL_UTILIZATION
        fee_buffer = available_capital * 0.005
        tradable_budget = available_capital - fee_buffer

        max_shares_from_capital = int(tradable_budget / entry_price)
        shares = (max_shares_from_capital // self.lot_size) * self.lot_size

        if shares < self.lot_size:
            max_shares_from_capital = int(available_capital / entry_price)
            shares = (max_shares_from_capital // self.lot_size) * self.lot_size

        if shares < self.lot_size:
            if entry_price * self.lot_size <= self.balance:
                shares = self.lot_size
            else:
                print(f"⚠️ Cannot afford even 1 lot @ {entry_price:.2f} "
                      f"(need {entry_price*self.lot_size:,.2f}, have {self.balance:,.2f})")
                return 0

        required_capital = shares * entry_price
        if required_capital > self.balance:
            shares = ((int(self.balance / entry_price)) // self.lot_size) * self.lot_size
            if shares < self.lot_size:
                if entry_price * self.lot_size <= self.balance:
                    shares = self.lot_size
                else:
                    return 0

        self.investment_per_trade = shares * entry_price
        risk_per_share = entry_price * self.active_sl_pct
        total_risk = shares * risk_per_share
        risk_percent = (total_risk / self.balance) * 100 if self.balance > 0 else 0
        used_pct = (self.investment_per_trade / self.balance) * 100 if self.balance > 0 else 0

        print(f"💰 Position: {shares} shares ({shares//self.lot_size} lots) @ {entry_price:.2f} | "
              f"Investment: {self.investment_per_trade:,.2f} ({used_pct:.1f}% of balance) | "
              f"Risk: {total_risk:,.2f} ({risk_percent:.2f}%) | "
              f"SL: {self.active_sl_pct*100:.2f}% | Target: {self.active_target_pct*100:.2f}% | "
              f"R:R: 1:{round(self.active_target_pct/self.active_sl_pct, 2)}")
        return shares

    def can_place_order(self):
        if self.last_order_time is None:
            return True
        elapsed = (datetime.datetime.now() - self.last_order_time).total_seconds()
        return elapsed >= self.order_retry_delay

    def calculate_fees(self, trade_value, side='entry'):
        brokerage = self.brokerage_fixed
        exchange = trade_value * self.exchange_txn
        sebi = trade_value * self.sebi_charges
        gst_base = brokerage + exchange + sebi
        gst = gst_base * self.gst_rate

        if side == 'entry':
            stamp = trade_value * self.stamp_duty
            stt = 0
        else:
            stamp = 0
            stt = trade_value * self.stt_sell

        return brokerage + exchange + sebi + gst + stamp + stt

    def check_exit(self, ce_price, pe_price):
        if self.position is None:
            return
        if self.entry_price is None or self.shares <= 0:
            return
        if self.current_instrument is None:
            return

        current_price = ce_price if self.current_instrument == INSTRUMENT_TOKEN_CE else pe_price

        if current_price <= 0:
            return

        should_exit = False
        exit_reason = ""

        if current_price >= self.target:
            should_exit = True
            exit_reason = f"TARGET HIT (+{self.active_target_pct*100:.2f}%)"
        elif current_price <= self.stop_loss * (1 + SL_TRIGGER_BUFFER):
            should_exit = True
            exit_reason = f"STOP LOSS HIT (-{self.active_sl_pct*100:.2f}%)"

        if not should_exit and self.last_order_time is not None:
            hold_time = (datetime.datetime.now() - self.last_order_time).total_seconds() / 60
            if hold_time > self.max_hold_time:
                should_exit = True
                exit_reason = f"TIME LIMIT ({hold_time:.1f} min)"

        if should_exit:
            self._close_position(current_price, exit_reason)

    def _close_position(self, exit_price, exit_reason):
        global trade_log_global, recent_trades, current_position

        try:
            exit_trade_value = exit_price * self.shares
            exit_fees = self.calculate_fees(exit_trade_value, side='exit')

            gross_pnl = (exit_price - self.entry_price) * self.shares
            net_pnl = gross_pnl - self.entry_fees_paid - exit_fees
            price_change_pct = ((exit_price - self.entry_price) / self.entry_price) * 100

            self.balance += exit_trade_value
            self.balance -= exit_fees
            self.total_fees_paid += exit_fees

            if net_pnl > 0:
                self.winning_trades += 1
                self.consecutive_losses = 0
                if net_pnl > self.largest_win:
                    self.largest_win = net_pnl
            else:
                self.losing_trades += 1
                self.consecutive_losses += 1
                if net_pnl < self.largest_loss:
                    self.largest_loss = net_pnl

            instrument_traded = "CE" if self.current_instrument == INSTRUMENT_TOKEN_CE else "PE"

            entry_price_saved = self.entry_price
            shares_saved = self.shares
            lots_saved = shares_saved // self.lot_size
            entry_fees_saved = self.entry_fees_paid
            target_pct_saved = self.active_target_pct
            sl_pct_saved = self.active_sl_pct

            self.position = None
            self.current_instrument = None
            self.entry_price = None
            self.stop_loss = None
            self.target = None
            self.shares = 0
            self.entry_fees_paid = 0
            self.current_trade_value = 0
            current_position = None

            win_rate = (self.winning_trades / self.total_trades * 100) if self.total_trades > 0 else 0

            trade_log = (
                f"🚀 EXIT {instrument_traded} ({exit_reason}): "
                f"{entry_price_saved:.2f} → {exit_price:.2f} ({price_change_pct:+.2f}%) | "
                f"Lots: {lots_saved} | "
                f"Target@{target_pct_saved*100:.2f}% SL@{sl_pct_saved*100:.2f}% | "
                f"Gross P&L: {gross_pnl:+,.2f} | "
                f"Net P&L: {net_pnl:+,.2f} | "
                f"Return: {net_pnl/self.initial_balance*100:+.2f}% | "
                f"Win Rate: {win_rate:.1f}% | "
                f"Balance: {self.balance:,.2f}"
            )
            print(f"✅ POSITION EXITED: {trade_log}")

            recent_trades.append({
                'time': datetime.datetime.now(),
                'entry_price': entry_price_saved,
                'exit_price': exit_price,
                'type': instrument_traded,
                'reason': exit_reason,
                'gross_pnl': gross_pnl,
                'net_pnl': net_pnl,
                'shares': shares_saved,
                'lots': lots_saved,
                'entry_fees': entry_fees_saved,
                'exit_fees': exit_fees,
                'target_pct': target_pct_saved,
                'sl_pct': sl_pct_saved
            })

            trade_log_global.append({
                'timestamp': datetime.datetime.now().isoformat(),
                'message': trade_log
            })

            with open("paper_trade_logs.txt", "a") as log_file:
                log_file.write(f"{datetime.datetime.now().isoformat()} - {trade_log}\n")

        except Exception as e:
            print(f"Error in _close_position: {e}")
            traceback.print_exc()

