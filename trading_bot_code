    def calculate_max_shares(self, entry_price, position_type='long'):
        if entry_price <= 0:
            return self.lot_size
        
        # FULL CAPITAL UTILIZATION - Use 95% of balance
        available_capital = self.balance * 0.95
        
        # Calculate max shares based on available capital
        max_shares_from_capital = int(available_capital / entry_price)
        
        # Round down to nearest lot size (10)
        shares = (max_shares_from_capital // self.lot_size) * self.lot_size
        
        # Ensure at least 1 lot
        if shares < self.lot_size:
            shares = self.lot_size
        
        # Check if this exceeds balance
        required_capital = shares * entry_price
        if required_capital > self.balance * 0.95:
            shares = ((int((self.balance * 0.95) / entry_price)) // self.lot_size) * self.lot_size
            if shares < self.lot_size:
                shares = self.lot_size
        
        self.investment_per_trade = shares * entry_price
        
        # Calculate risk amount
        risk_per_share = entry_price * self.sl_pct
        total_risk = shares * risk_per_share
        risk_percent = (total_risk / self.balance) * 100
        
        print(f"💰 Position: {shares} shares ({shares//self.lot_size} lots) @ {entry_price:.2f} | "
              f"Investment: {self.investment_per_trade:,.2f} ({self.investment_per_trade/self.balance*100:.1f}% of capital) | "
              f"Risk: {total_risk:,.2f} ({risk_percent:.2f}% of capital) | "
              f"SL: {self.sl_pct*100:.1f}% | Target: {self.target_pct*100:.1f}% | "
              f"Risk-Reward: 1:{self.risk_reward_ratio}")
        
        return shares

    def can_place_order(self):
        if self.last_order_time is None:
            return True
        elapsed = (datetime.datetime.now() - self.last_order_time).total_seconds()
        return elapsed >= self.order_retry_delay

    def calculate_fees(self, trade_value, side='entry'):
        brokerage = self.brokerage_fixed
        exchange = trade_value * self.exchange_txn
        sebi = trade_value * self.sebi_charges
        gst_base = brokerage + exchange + sebi
        gst = gst_base * self.gst_rate
        
        if side == 'entry':
            stamp = trade_value * self.stamp_duty
            stt = 0
        else:
            stamp = 0
            stt = trade_value * self.stt_sell
            
        total_fees = brokerage + exchange + sebi + gst + stamp + stt
        return total_fees

