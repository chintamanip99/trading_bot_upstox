def market_regime_ok(price_data, window=10):
    if len(price_data) < window:
        return False
    recent = np.array(price_data[-window:], dtype=float)
    if np.any(recent <= 0):
        return False

    returns = np.diff(recent) / recent[:-1]
    volatility = float(np.std(returns))
    trend = float((recent[-1] - recent[0]) / recent[0])

    if volatility > 0.012:      # loosened from 0.008
        return False
    if abs(trend) < 0.001:      # loosened from 0.002
        return False
    return True


