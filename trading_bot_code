    def get_performance_stats(self):
        total_return = self.balance - self.initial_balance
        return_pct = (total_return / self.initial_balance) * 100 if self.initial_balance > 0 else 0
        win_rate = (self.winning_trades / self.total_trades * 100) if self.total_trades > 0 else 0
        
        total_profit = 0
        total_loss = 0
        for trade in recent_trades[-100:]:
            if trade.get('net_pnl', 0) > 0:
                total_profit += trade.get('net_pnl', 0)
            else:
                total_loss += abs(trade.get('net_pnl', 0))
        
        profit_factor = total_profit / total_loss if total_loss > 0 else 0
        
        return {
            'initial_balance': float(self.initial_balance),
            'current_balance': float(self.balance),
            'total_return': float(total_return),
            'return_percentage': float(return_pct),
            'total_trades': int(self.total_trades),
            'winning_trades': int(self.winning_trades),
            'losing_trades': int(self.losing_trades),
            'win_rate': float(win_rate),
