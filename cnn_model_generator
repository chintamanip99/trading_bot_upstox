def create_gaf_images(data, columns, window_size):
    """
    Create Gramian Angular Field images from time series data.

    For each window we build a multi-channel image of shape:
        (n_features, window_size, window_size)

    Returns array of shape (N, n_features, window_size, window_size).
    """
    gaf = GramianAngularField(method='summation', image_size=window_size)
    gaf_images = []

    for i in range(window_size, len(data)):
        # shape: (window_size, n_features) -> transpose to (n_features, window_size)
        window_data = data.iloc[i - window_size:i][columns].values.T.astype(np.float64)
        try:
            gaf_image = gaf.fit_transform(window_data)  # (n_features, W, W)
            gaf_images.append(gaf_image)
        except Exception as e:
            print(f"Error creating GAF image at index {i}: {e}")
            continue

    return np.array(gaf_images)  # (N, n_features, W, W)


def create_cnn_model(input_shape):
    """Create CNN model for classification."""
    model = Sequential([
        Conv2D(32, (3, 3), activation='swish', padding='same', input_shape=input_shape),
        BatchNormalization(),
        MaxPooling2D(pool_size=(2, 2)),
        Dropout(0.2),

        Conv2D(64, (3, 3), activation='swish', padding='same'),
        BatchNormalization(),
        MaxPooling2D(pool_size=(2, 2)),
        Dropout(0.2),

        Conv2D(128, (3, 3), activation='swish', padding='same'),
        BatchNormalization(),
        MaxPooling2D(pool_size=(2, 2)),
        Dropout(0.2),

        Flatten(),
        Dense(128, activation='swish'),
        Dropout(0.3),
        Dense(64, activation='swish'),
        Dropout(0.2),
        Dense(3, activation='softmax')  # Hold, Buy, Sell
    ])

    model.compile(
        optimizer=Adam(learning_rate=LEARNING_RATE),
        loss='sparse_categorical_crossentropy',
        metrics=['accuracy']
    )

    return model


def main():
    print("=" * 60)
    print("CNN TRAINING WITH OHLCV + OI FEATURES")
    print("=" * 60)
    print(f"Features: {FEATURES}")
    print(f"Window size: {WINDOW_SIZE}")
    print(f"Target position: {TARGET_POSITION} candles ahead")
    print("=" * 60)

    print("\n📊 Fetching and preprocessing data...")
    btc_data, features = fetch_and_preprocess_data()

    if btc_data is None or len(btc_data) < WINDOW_SIZE + TARGET_POSITION:
        print("❌ Error: Not enough data for training")
        return

    print(f"✅ Data shape: {btc_data.shape}")
    print(f"✅ Features: {features}")

    print("\n🔄 Creating GAF images...")
    gaf_images = create_gaf_images(btc_data, features, WINDOW_SIZE)

    if len(gaf_images) == 0:
        print("❌ Error: No GAF images created")
        return

    # gaf_images: (N, n_features, W, W)
    # transpose to (N, W, W, n_features) for channels-last Conv2D
    X_gaf = np.transpose(gaf_images, (0, 2, 3, 1))
    y_labels = btc_data['label'].values[WINDOW_SIZE:]

    # Sanity-check shapes align
    min_len = min(len(X_gaf), len(y_labels))
    X_gaf = X_gaf[:min_len]
    y_labels = y_labels[:min_len]

    print(f"✅ GAF images shape: {X_gaf.shape}")
    print(f"✅ Labels shape: {y_labels.shape}")
    print(f"Class Distribution (Before): {np.bincount(y_labels)}")

    unique_classes = np.unique(y_labels)
    if len(unique_classes) < 2:
        print(f"❌ Error: Only found {len(unique_classes)} classes. Need at least 2.")
        return

    print("\n⚖️ Balancing classes using RandomOverSampler...")
    ros = RandomOverSampler(random_state=42)
    X_reshaped = X_gaf.reshape(X_gaf.shape[0], -1)
    X_resampled, y_resampled = ros.fit_resample(X_reshaped, y_labels)
    X_resampled = X_resampled.reshape(-1, WINDOW_SIZE, WINDOW_SIZE, len(features))
    print(f"Class Distribution (After): {np.bincount(y_resampled)}")

    print("\n📊 Splitting data into train and validation sets...")
    X_train, X_val, y_train, y_val = train_test_split(
        X_resampled, y_resampled, test_size=0.2, random_state=42, stratify=y_resampled)

    print(f"Training samples: {len(X_train)}")
    print(f"Validation samples: {len(X_val)}")

    print("\n🧠 Creating CNN model...")
    model = create_cnn_model((WINDOW_SIZE, WINDOW_SIZE, len(features)))
    model.summary()

    reduce_lr = ReduceLROnPlateau(
        monitor='val_loss', factor=0.5, patience=10, min_lr=1e-5, verbose=1
    )
    early_stop = EarlyStopping(
        monitor='val_loss', patience=20, restore_best_weights=True, verbose=1
    )

    print("\n🚀 Training model...")
    history = model.fit(
        X_train, y_train,
        epochs=EPOCHS,
        batch_size=BATCH_SIZE,
        validation_data=(X_val, y_val),
        callbacks=[reduce_lr, early_stop],
        verbose=1
    )

    print("\n📊 Evaluating model...")
    y_pred = model.predict(X_val)
    y_pred_classes = np.argmax(y_pred, axis=1)

    present_classes = np.unique(y_val)
    target_names = ['Hold', 'Buy', 'Sell']
    present_target_names = [target_names[i] for i in present_classes if i < len(target_names)]

    print("\n📈 Class distribution in validation set:")
    for i, count in enumerate(np.bincount(y_val)):
        if i < len(target_names):
            print(f"{target_names[i]}: {count}")

    print("\n📋 Classification Report:")
    print(classification_report(y_val, y_pred_classes, target_names=present_target_names))

    # ---- CHANGED: model saved as cnn_fixed.h5 ----
