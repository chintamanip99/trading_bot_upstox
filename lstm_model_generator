    def predict_next(self, last_sequence):
        """
        Make prediction for next price
        
        Args:
            last_sequence: Last lookback window of OHLCV data
            
        Returns:
            Predicted price
        """
        if self.model is None:
            raise ValueError("Model not trained yet!")
        
        # Scale the input sequence
        scaled_sequence = self.scaler_X.transform(last_sequence)
        scaled_sequence = scaled_sequence.reshape(1, self.lookback, -1)
        
        # Predict
        prediction_scaled = self.model.predict(scaled_sequence)
        prediction = self.scaler_y.inverse_transform(prediction_scaled)
        
        return prediction[0][0]
    
    def visualize_predictions(self, y_test, y_pred, plot_metrics=True):
        """Visualize actual vs predicted prices with metrics"""
        fig, axes = plt.subplots(2, 2, figsize=(15, 10))
        
        # Plot 1: Actual vs Predicted
        ax1 = axes[0, 0]
        ax1.plot(y_test, label='Actual Prices', color='blue', alpha=0.7)
        ax1.plot(y_pred, label='Predicted Prices', color='red', alpha=0.7)
        ax1.set_title(f'LSTM Predictions (lookback={self.lookback}, target={self.target_position})')
        ax1.set_xlabel('Test Sample Index')
        ax1.set_ylabel('Price')
        ax1.legend()
        ax1.grid(True, alpha=0.3)
        
        # Plot 2: Scatter plot with R²
        ax2 = axes[0, 1]
        ax2.scatter(y_test, y_pred, alpha=0.5)
        ax2.plot([y_test.min(), y_test.max()], [y_test.min(), y_test.max()], 'r--', lw=2)
        ax2.set_xlabel('Actual Prices')
        ax2.set_ylabel('Predicted Prices')
        ax2.set_title(f'Actual vs Predicted (R² = {self.test_metrics["R2"]:.4f})')
        ax2.grid(True, alpha=0.3)
        
        # Plot 3: Residuals
        ax3 = axes[1, 0]
        residuals = y_test - y_pred
        ax3.scatter(range(len(residuals)), residuals, alpha=0.5)
        ax3.axhline(y=0, color='r', linestyle='--', linewidth=2)
        ax3.set_xlabel('Test Sample Index')
        ax3.set_ylabel('Residuals (Actual - Predicted)')
        ax3.set_title(f'Residual Plot (MAE = {self.test_metrics["MAE"]:.4f})')
        ax3.grid(True, alpha=0.3)
        
        # Plot 4: Error Distribution
        ax4 = axes[1, 1]
        ax4.hist(residuals, bins=30, edgecolor='black', alpha=0.7)
        ax4.axvline(x=0, color='r', linestyle='--', linewidth=2)
        ax4.set_xlabel('Residuals')
        ax4.set_ylabel('Frequency')
        ax4.set_title(f'Error Distribution (RMSE = {self.test_metrics["RMSE"]:.4f})')
        ax4.grid(True, alpha=0.3)
        
        plt.tight_layout()
        plt.show()
    
    def get_metrics_summary(self):
        """Return a summary DataFrame of all metrics"""
        metrics_df = pd.DataFrame({
            'Metric': ['R²', 'MSE', 'RMSE', 'MAE', 'MAPE'],
            'Training': [
                self.training_metrics.get('R2', np.nan),
                self.training_metrics.get('MSE', np.nan),
                self.training_metrics.get('RMSE', np.nan),
                self.training_metrics.get('MAE', np.nan),
                self.training_metrics.get('MAPE', np.nan)
            ],
            'Test': [
                self.test_metrics.get('R2', np.nan),
                self.test_metrics.get('MSE', np.nan),
                self.test_metrics.get('RMSE', np.nan),
                self.test_metrics.get('MAE', np.nan),
                self.test_metrics.get('MAPE', np.nan)
            ]
        })
        
        # Format MAPE with % sign
        metrics_df.loc[metrics_df['Metric'] == 'MAPE', 'Training'] = \
            metrics_df.loc[metrics_df['Metric'] == 'MAPE', 'Training'].apply(
                lambda x: f"{x:.2f}%" if not np.isnan(x) else "NaN"
            )
        metrics_df.loc[metrics_df['Metric'] == 'MAPE', 'Test'] = \
            metrics_df.loc[metrics_df['Metric'] == 'MAPE', 'Test'].apply(
                lambda x: f"{x:.2f}%" if not np.isnan(x) else "NaN"
            )
        
        return metrics_df

