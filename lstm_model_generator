        else:
            print(f"✗ MAPE = {mape:.2f}% - Poor accuracy")

    # -----------------------------------------------------
    # Predict next price
    # -----------------------------------------------------
    def predict_next(self, df):
        """
        Feed the last `lookback` rows of raw df, predict next Close price.
        df must contain columns Open, High, Low, Close, Volume, OI.
        """
        if self.model is None:
            raise ValueError("Model not trained/loaded yet!")

        recent = df.tail(self.lookback + 1).copy()
        feat = self._make_features(recent)

        if len(feat) < self.lookback:
            raise ValueError(f"Not enough recent rows to build {self.lookback} features")

        feat = feat.tail(self.lookback).values.astype(np.float32)
        feat_scaled = self.scaler_X.transform(feat).reshape(
            1, self.lookback, feat.shape[1]
        )

        pred_ret_scaled = self.model.predict(feat_scaled)
        pred_ret = self.scaler_y.inverse_transform(pred_ret_scaled)[0, 0]

        last_close = float(df['Close'].iloc[-1])
        predicted_price = last_close * np.exp(pred_ret)

        return predicted_price

    # -----------------------------------------------------
    # Visualize
    # -----------------------------------------------------
    def visualize_predictions(self, y_test, y_pred):
        fig, axes = plt.subplots(2, 2, figsize=(15, 10))

        ax1 = axes[0, 0]
        ax1.plot(y_test, label='Actual Prices', color='blue', alpha=0.7)
        ax1.plot(y_pred, label='Predicted Prices', color='red', alpha=0.7)
        ax1.set_title(f'LSTM Predictions (lookback={self.lookback}, target={self.target_position})')
        ax1.set_xlabel('Test Sample Index')
        ax1.set_ylabel('Price')
        ax1.legend()
        ax1.grid(True, alpha=0.3)

        ax2 = axes[0, 1]
        ax2.scatter(y_test, y_pred, alpha=0.5)
        ax2.plot([y_test.min(), y_test.max()],
                 [y_test.min(), y_test.max()], 'r--', lw=2)
        ax2.set_xlabel('Actual Prices')
        ax2.set_ylabel('Predicted Prices')
        ax2.set_title(f'Actual vs Predicted (R² = {self.test_metrics["R2"]:.4f})')
        ax2.grid(True, alpha=0.3)

        ax3 = axes[1, 0]
        residuals = y_test - y_pred
        ax3.scatter(range(len(residuals)), residuals, alpha=0.5)
        ax3.axhline(y=0, color='r', linestyle='--', linewidth=2)
        ax3.set_xlabel('Test Sample Index')
        ax3.set_ylabel('Residuals')
        ax3.set_title(f'Residual Plot (MAE = {self.test_metrics["MAE"]:.4f})')
        ax3.grid(True, alpha=0.3)

        ax4 = axes[1, 1]
        ax4.hist(residuals, bins=30, edgecolor='black', alpha=0.7)
        ax4.axvline(x=0, color='r', linestyle='--', linewidth=2)
        ax4.set_xlabel('Residuals')
        ax4.set_ylabel('Frequency')
        ax4.set_title(f'Error Distribution (RMSE = {self.test_metrics["RMSE"]:.4f})')
        ax4.grid(True, alpha=0.3)

        plt.tight_layout()
        plt.show()

    # -----------------------------------------------------
    # Metrics summary table
    # -----------------------------------------------------
    def get_metrics_summary(self):
        rows = []
        for m in ['R2', 'MSE', 'RMSE', 'MAE', 'MAPE']:
            tr = self.training_metrics.get(m, np.nan)
            te = self.test_metrics.get(m, np.nan)
            if m == 'MAPE':
                tr = f"{tr:.2f}%" if not np.isnan(tr) else "NaN"
                te = f"{te:.2f}%" if not np.isnan(te) else "NaN"
            rows.append({'Metric': m, 'Training': tr, 'Test': te})
        return pd.DataFrame(rows)


