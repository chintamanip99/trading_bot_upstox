                print(f"⚠️ /update failed (status: {response.status_code})")
                print(f"   Response: {response.text}")
        except requests.exceptions.ConnectionError:
            print("⚠️ Trading bot not running or unreachable (/update)")
        except Exception as e:
            print(f"❌ Error triggering model reload: {e}")

    # -----------------------------------------------------
    # Save / Load
    # -----------------------------------------------------
    def save_model(self):
        if self.model is None:
            print("⚠️ No model to save. Train the model first.")
            return

        try:
            self.model.save(self.model_filename)
            print(f"✅ Model saved as '{self.model_filename}'")

            joblib.dump(self.scaler_X, self.scaler_X_filename)
            joblib.dump(self.scaler_y, self.scaler_y_filename)
            print(f"✅ Feature scaler saved as '{self.scaler_X_filename}'")
            print(f"✅ Target scaler saved as '{self.scaler_y_filename}'")

            config = {
                'lookback': self.lookback,
                'target_position': self.target_position,
                'feature_columns': self.FEATURE_COLS,
                'feature_engineering': 'log_return_OHLC + diff_log1p_Volume_OI',
                'target': 'log_return_of_Close_at_t+target_position',
                'training_metrics': self.training_metrics,
                'test_metrics': self.test_metrics,
                'model_filename': self.model_filename,
                'scaler_X_filename': self.scaler_X_filename,
                'scaler_y_filename': self.scaler_y_filename,
                'last_close': self._last_close,
                'saved_date': datetime.datetime.now().isoformat()
            }

            pd.DataFrame([config]).to_csv('lstm_model_config.csv', index=False)
            print("✅ Model configuration saved as 'lstm_model_config.csv'")

            with open('lstm_model_summary.txt', 'w') as f:
                f.write("=" * 60 + "\n")
                f.write("LSTM MODEL SUMMARY\n")
                f.write("=" * 60 + "\n\n")
                f.write(f"Model filename: {self.model_filename}\n")
                f.write(f"Lookback: {self.lookback}\n")
                f.write(f"Target position: {self.target_position}\n")
                f.write("Features: log-return(OHLC) + diff(log1p(Volume)) + diff(log1p(OI))\n")
                f.write("Target: log-return of Close\n")
                f.write(f"Saved date: {datetime.datetime.now().isoformat()}\n\n")

                f.write("TRAINING METRICS:\n")
                f.write("-" * 40 + "\n")
                for k, v in self.training_metrics.items():
                    f.write(f"{k}: {v:.6f}\n" if k != 'MAPE' else f"{k}: {v:.2f}%\n")

                f.write("\nTEST METRICS:\n")
                f.write("-" * 40 + "\n")
                for k, v in self.test_metrics.items():
                    f.write(f"{k}: {v:.6f}\n" if k != 'MAPE' else f"{k}: {v:.2f}%\n")

                f.write("\n" + "=" * 60 + "\n")

            print("✅ Model summary saved as 'lstm_model_summary.txt'")

        except Exception as e:
            print(f"❌ Error saving model: {e}")

    def load_model(self):
        try:
            if os.path.exists(self.model_filename):
                self.model = load_model(self.model_filename)
                print(f"✅ Model loaded from '{self.model_filename}'")
            else:
                print(f"⚠️ Model file '{self.model_filename}' not found")
                return False

            if os.path.exists(self.scaler_X_filename):
                self.scaler_X = joblib.load(self.scaler_X_filename)
                print(f"✅ Feature scaler loaded from '{self.scaler_X_filename}'")
            else:
                print(f"⚠️ Scaler file '{self.scaler_X_filename}' not found")
                return False

            if os.path.exists(self.scaler_y_filename):
                self.scaler_y = joblib.load(self.scaler_y_filename)
                print(f"✅ Target scaler loaded from '{self.scaler_y_filename}'")
            else:
                print(f"⚠️ Scaler file '{self.scaler_y_filename}' not found")
                return False

            if os.path.exists('lstm_model_config.csv'):
                cfg = pd.read_csv('lstm_model_config.csv')
                if 'last_close' in cfg.columns:
                    self._last_close = float(cfg['last_close'].iloc[0])
                if 'lookback' in cfg.columns:
                    self.lookback = int(cfg['lookback'].iloc[0])
                if 'target_position' in cfg.columns:
                    self.target_position = int(cfg['target_position'].iloc[0])

            return True

        except Exception as e:
            print(f"❌ Error loading model: {e}")
            return False

