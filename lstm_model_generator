        print(f"⚠️ Could not make next-price prediction: {e}")


def test_loaded_model():
    """Test loading the saved model"""
    print("\n" + "=" * 60)
    print("TESTING LOADED MODEL")
    print("=" * 60)

    predictor = LSTMPricePredictor(lookback=30, target_position=1)

    if predictor.load_model():
        print("\n✅ Model loaded successfully!")

        print("\nFetching new data for testing...")
        df = fetch_historical_data()

        if df is not None and len(df) >= predictor.lookback + 1:
            next_price = predictor.predict_next(df)
            current_price = df['Close'].iloc[-1]

            print("\n" + "=" * 60)
            print("PREDICTION USING LOADED MODEL")
            print("=" * 60)
            print(f"Current price:        ₹{current_price:.2f}")
            print(f"Predicted next price: ₹{next_price:.2f}")
            print(f"Expected change:      ₹{next_price - current_price:.2f} "
                  f"({((next_price - current_price) / current_price * 100):.2f}%)")
            print("=" * 60)
    else:
        print("❌ Failed to load model")


