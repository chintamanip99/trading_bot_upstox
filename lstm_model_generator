def calculate_metrics(y_true, y_pred):
    """
    Calculate multiple regression metrics
    
    Args:
        y_true: Actual values
        y_pred: Predicted values
        
    Returns:
        Dictionary with all metrics
    """
    # Handle any potential NaN or infinite values
    y_true = np.array(y_true).flatten()
    y_pred = np.array(y_pred).flatten()
    
    # Remove any NaN values
    mask = ~(np.isnan(y_true) | np.isnan(y_pred) | 
             np.isinf(y_true) | np.isinf(y_pred))
    y_true = y_true[mask]
    y_pred = y_pred[mask]
    
    if len(y_true) == 0:
        return {
            'R2': np.nan,
            'MSE': np.nan,
            'RMSE': np.nan,
            'MAE': np.nan,
            'MAPE': np.nan
        }
    
    # Calculate metrics
    r2 = r2_score(y_true, y_pred)
    mse = mean_squared_error(y_true, y_pred)
    rmse = np.sqrt(mse)
    mae = mean_absolute_error(y_true, y_pred)
    
    # MAPE (Mean Absolute Percentage Error)
    # Avoid division by zero
    mask_nonzero = y_true != 0
    if np.sum(mask_nonzero) > 0:
        mape = np.mean(np.abs((y_true[mask_nonzero] - y_pred[mask_nonzero]) / 
                              y_true[mask_nonzero])) * 100
    else:
        mape = np.nan
    
    return {
        'R2': r2,
        'MSE': mse,
        'RMSE': rmse,
        'MAE': mae,
        'MAPE': mape
    }

class LSTMPricePredictor:
    def __init__(self, lookback=10, target_position=1):
        """
        Initialize LSTM predictor
        
        Args:
            lookback (int): Number of time steps to look back
            target_position (int): Which future price to predict (0-indexed from current)
        """
        self.lookback = lookback
        self.target_position = target_position
        self.scaler_X = MinMaxScaler()
        self.scaler_y = MinMaxScaler()
        self.model = None
        self.training_metrics = {}
        self.test_metrics = {}
        self.model_filename = "lstm_new.h5"
        self.scaler_X_filename = "scaler_X.pkl"
        self.scaler_y_filename = "scaler_y.pkl"
        
    def prepare_data(self, df):
        """
        Prepare data for LSTM with OHLCV features and target_position price as target
        
        Args:
            df (pd.DataFrame): DataFrame with OHLCV columns
            
        Returns:
            X, y: Features and targets for training
        """
        # Use all OHLCV columns as features
        feature_cols = ['Open', 'High', 'Low', 'Close', 'Volume', 'OI']
        
        # Scale the features
        scaled_data = self.scaler_X.fit_transform(df[feature_cols].values)
        scaled_df = pd.DataFrame(scaled_data, columns=feature_cols, index=df.index)
        
        X, y = [], []
        
        for i in range(len(scaled_df) - self.lookback - self.target_position):
            # Features: lookback window of OHLCV data
            X.append(scaled_df.iloc[i:i+self.lookback].values)
            
            # Target: the Close price at target_position steps ahead
            target_price = df['Close'].iloc[i+self.lookback+self.target_position]
            y.append(target_price)
        
        return np.array(X), np.array(y)
    
    def build_model(self, input_shape):
        """Build LSTM model"""
        model = Sequential([
            LSTM(units=50, return_sequences=True, input_shape=input_shape),
            Dropout(0.2),
            LSTM(units=50, return_sequences=False),
            Dropout(0.2),
            Dense(units=25),
            Dense(units=1)
        ])
        
        model.compile(optimizer=Adam(learning_rate=0.001), loss='mean_squared_error')
        return model
    
    def train(self, X, y, test_size=0.2, epochs=50, batch_size=32):
        """
        Train the LSTM model
        
        Args:
            X, y: Features and targets
            test_size: Proportion of data for testing
            epochs: Number of training epochs
            batch_size: Batch size for training
        """
        # Split data
        X_train, X_test, y_train, y_test = train_test_split(
            X, y, test_size=test_size, shuffle=False
        )
        
        # Scale the target values
        y_train_scaled = self.scaler_y.fit_transform(y_train.reshape(-1, 1))
        y_test_scaled = self.scaler_y.transform(y_test.reshape(-1, 1))
        
        # Build and train model
        self.model = self.build_model((X.shape[1], X.shape[2]))
        
        early_stopping = EarlyStopping(
            monitor='val_loss', 
            patience=10, 
            restore_best_weights=True
        )
        
        history = self.model.fit(
            X_train, y_train_scaled,
            epochs=epochs,
            batch_size=batch_size,
            validation_split=0.2,
            callbacks=[early_stopping],
            verbose=1
        )
        
        # Make predictions
        y_train_pred_scaled = self.model.predict(X_train)
        y_test_pred_scaled = self.model.predict(X_test)
        
        # Inverse transform predictions
        y_train_pred = self.scaler_y.inverse_transform(y_train_pred_scaled)
        y_test_pred = self.scaler_y.inverse_transform(y_test_pred_scaled)
        
        # Calculate metrics for training set
        self.training_metrics = calculate_metrics(y_train, y_train_pred)
        
        # Calculate metrics for test set
        self.test_metrics = calculate_metrics(y_test, y_test_pred)
        
        # Print metrics
        self.print_metrics()
        
        # Save the model
        self.save_model()
        
        # Update the trading bot with LSTM MAE
        self.update_trading_bot()
        
        return history, y_test, y_test_pred.flatten()
    
    def update_trading_bot(self):
        """Update the trading bot with LSTM MAE metric"""
        try:
            # Get MAE from test metrics
            lstm_mae = self.test_metrics.get('MAE', 0)
            
            if lstm_mae > 0:
                # Send update to trading bot - use 'LSTM' key
