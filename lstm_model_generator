# =========================================================
# METRICS
# =========================================================
def calculate_metrics(y_true, y_pred):
    y_true = np.array(y_true).flatten()
    y_pred = np.array(y_pred).flatten()

    mask = ~(np.isnan(y_true) | np.isnan(y_pred) |
             np.isinf(y_true) | np.isinf(y_pred))
    y_true = y_true[mask]
    y_pred = y_pred[mask]

    if len(y_true) == 0:
        return {'R2': np.nan, 'MSE': np.nan, 'RMSE': np.nan,
                'MAE': np.nan, 'MAPE': np.nan}

    r2 = r2_score(y_true, y_pred)
    mse = mean_squared_error(y_true, y_pred)
    rmse = np.sqrt(mse)
    mae = mean_absolute_error(y_true, y_pred)

    mask_nonzero = y_true != 0
    if np.sum(mask_nonzero) > 0:
        mape = np.mean(np.abs((y_true[mask_nonzero] - y_pred[mask_nonzero]) /
                              y_true[mask_nonzero])) * 100
    else:
        mape = np.nan

    return {'R2': r2, 'MSE': mse, 'RMSE': rmse, 'MAE': mae, 'MAPE': mape}


# =========================================================
# PREDICTOR
# =========================================================
class LSTMPricePredictor:
    FEATURE_COLS = ['Open', 'High', 'Low', 'Close', 'Volume', 'OI']

    def __init__(self, lookback=30, target_position=1):
        """
        Args:
            lookback (int): number of past candles fed into LSTM
            target_position (int): how many steps ahead we predict (1 = next candle)
        """
        self.lookback = lookback
        self.target_position = target_position

        self.scaler_X = MinMaxScaler()
        self.scaler_y = MinMaxScaler()

        self.model = None
        self.training_metrics = {}
        self.test_metrics = {}

        # ---- CHANGED: model filename now lstm_fixed.h5 ----
        self.model_filename = "lstm_fixed.h5"
        self.scaler_X_filename = "scaler_X.pkl"
        self.scaler_y_filename = "scaler_y.pkl"

        # last known close for return -> price reconstruction
        self._last_close = None

    # -----------------------------------------------------
    # Feature engineering: turn raw OHLCV+OI into stationary
    # -----------------------------------------------------
    @staticmethod
    def _make_features(df):
        """
        Convert raw OHLCV+OI into stationary features:
          - log-return of Open, High, Low, Close
          - diff of log1p(Volume)
          - diff of log1p(OI)
        """
        feat = pd.DataFrame(index=df.index)

        for c in ['Open', 'High', 'Low', 'Close']:
            feat[c] = np.log(df[c] / df[c].shift(1))

        feat['Volume'] = np.log1p(df['Volume']).diff()
        feat['OI'] = np.log1p(df['OI']).diff()

        feat.replace([np.inf, -np.inf], np.nan, inplace=True)
        feat.dropna(inplace=True)
        return feat

    # -----------------------------------------------------
    # Prepare X, y
    # -----------------------------------------------------
    def prepare_data(self, df):
        """
        Build X (lookback window of stationary features) and
        y (log-return from Close[t+tp-1] -> Close[t+tp]).
        """
        feat_df = self._make_features(df)

        # align close series to the feature index
        close = df['Close'].reindex(feat_df.index)

        # target: log-return at t + target_position
        target = np.log(close.shift(-self.target_position) /
                        close.shift(-self.target_position - 1))

        # align
        target = target.reindex(feat_df.index)
        valid = target.notna()
        feat_df = feat_df.loc[valid]
        target = target.loc[valid]

        feat_vals = feat_df.values.astype(np.float32)
        target_vals = target.values.astype(np.float32)

        n_samples = len(feat_df) - self.lookback + 1
        if n_samples <= 0:
            raise ValueError("Not enough data for the given lookback")

        X = np.zeros((n_samples, self.lookback, feat_vals.shape[1]), dtype=np.float32)
        y = np.zeros(n_samples, dtype=np.float32)

        for i in range(n_samples):
            X[i] = feat_vals[i:i + self.lookback]
            y[i] = target_vals[i + self.lookback - 1]

        # store last real close for later use
        self._last_close = float(df['Close'].iloc[-1])

        return X, y

    # -----------------------------------------------------
    # Model
    # -----------------------------------------------------
    def build_model(self, input_shape):
        model = Sequential([
            LSTM(units=64, return_sequences=True, input_shape=input_shape),
            Dropout(0.2),
            LSTM(units=64, return_sequences=False),
            Dropout(0.2),
            Dense(units=32, activation='relu'),
            Dense(units=1)
        ])
        model.compile(optimizer=Adam(learning_rate=0.001), loss='mean_squared_error')
        return model

    # -----------------------------------------------------
    # Train
    # -----------------------------------------------------
    def train(self, X, y, df, test_size=0.2, epochs=80, batch_size=32):
        """
        df is passed so we can reconstruct the actual Close prices for metrics.
        """
        # ---- Chronological split ----
        split_idx = int(len(X) * (1 - test_size))
        X_train, X_test = X[:split_idx], X[split_idx:]
        y_train, y_test = y[:split_idx], y[split_idx:]

        # ---- Fit scalers ONLY on training data ----
        n_train, lb, n_feat = X_train.shape
        self.scaler_X.fit(X_train.reshape(-1, n_feat))
        X_train_scaled = self.scaler_X.transform(
            X_train.reshape(-1, n_feat)).reshape(n_train, lb, n_feat)
        X_test_scaled = self.scaler_X.transform(
            X_test.reshape(-1, n_feat)).reshape(X_test.shape)

        y_train_scaled = self.scaler_y.fit_transform(y_train.reshape(-1, 1))
        y_test_scaled = self.scaler_y.transform(y_test.reshape(-1, 1))

        # ---- Build model ----
        self.model = self.build_model((X_train.shape[1], X_train.shape[2]))

        early_stopping = EarlyStopping(
            monitor='val_loss',
            patience=15,
            restore_best_weights=True
        )

        history = self.model.fit(
            X_train_scaled, y_train_scaled,
            epochs=epochs,
            batch_size=batch_size,
            validation_split=0.15,
            callbacks=[early_stopping],
            verbose=1
        )

        # ---- Predict log-returns ----
        y_train_pred_ret = self.scaler_y.inverse_transform(
            self.model.predict(X_train_scaled)).flatten()
        y_test_pred_ret = self.scaler_y.inverse_transform(
            self.model.predict(X_test_scaled)).flatten()

        # ---- Reconstruct actual Close prices ----
        feat_df = self._make_features(df)
        close_full = df['Close'].reindex(feat_df.index)

        target_close_positions = (
            np.arange(len(X)) + self.lookback - 1 + self.target_position
        )

        train_positions = target_close_positions[:split_idx]
        test_positions = target_close_positions[split_idx:]

        def build_price_arrays(positions, return_preds):
            prev_close = close_full.iloc[positions - 1].values
            actual_close = close_full.iloc[positions].values
            pred_close = prev_close * np.exp(return_preds)
            return actual_close, pred_close

        y_train_actual_price, y_train_pred_price = build_price_arrays(
            train_positions, y_train_pred_ret
        )
        y_test_actual_price, y_test_pred_price = build_price_arrays(
            test_positions, y_test_pred_ret
        )

        # ---- Metrics ----
        self.training_metrics = calculate_metrics(y_train_actual_price, y_train_pred_price)
        self.test_metrics = calculate_metrics(y_test_actual_price, y_test_pred_price)

        self.print_metrics()
        self.save_model()
        self.update_trading_bot()

        return history, y_test_actual_price, y_test_pred_price

